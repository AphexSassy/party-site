{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/art/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/party-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Anton|Six Caps|Jost|Pinyon Script|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Anton, Six Caps, Jost, Pinyon Script, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|blink|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, blink, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|ink|white|orange)$/]",
        "message": "<Badge> tone must be one of 'red' | 'ink' | 'white' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|index|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, index, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|flash|orange|ghost|classic)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'flash' | 'orange' | 'ghost' | 'classic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|code|title|crop|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, code, title, crop, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:paper|bone|crimson|ink)$/]",
        "message": "<Card> variant must be one of 'paper' | 'bone' | 'crimson' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|dark|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, dark, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|actions|icon|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, children, actions, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlitchText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|color|glitch|ghost|speed|shake|style|key|ref|className|style|children)$/]",
        "message": "<GlitchText> doesn't accept that prop. Declared props: children, as, color, glitch, ghost, speed, shake, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|glyph|tone|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, glyph, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|ink|white)$/]",
        "message": "<IconButton> tone must be one of 'red' | 'ink' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|num|href|onClick|dark|key|ref|className|style|children)$/]",
        "message": "<IndexLink> doesn't accept that prop. Declared props: title, sub, num, href, onClick, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|code|hint|error|dark|variant|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, code, hint, error, dark, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:slab|classic)$/]",
        "message": "<Input> variant must be one of 'slab' | 'classic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|num|prefix|arrow|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: children, href, active, num, prefix, arrow, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|red|white)$/]",
        "message": "<NavLink> tone must be one of 'ink' | 'red' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Polaroid'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|scrawl|mono|tilt|width|style|key|ref|className|style|children)$/]",
        "message": "<Polaroid> doesn't accept that prop. Declared props: src, alt, caption, scrawl, mono, tilt, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|options|value|defaultValue|onChange|dark|direction|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: name, options, value, defaultValue, onChange, dark, direction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<Radio> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RetroTVChannel'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|src|key|ref|className|style|children)$/]",
        "message": "<RetroTVChannel> doesn't accept that prop. Declared props: text, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|dark|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShardBurst'] > JSXAttribute > JSXIdentifier[name!=/^(?:palette|seed|density|originX|originY|spread|rotate|lines|slabs|background|animate|drift|interactive|explodeOnClick|width|height|style|className|key|ref|className|style|children)$/]",
        "message": "<ShardBurst> doesn't accept that prop. Declared props: palette, seed, density, originX, originY, spread, rotate, lines, slabs, background, animate, drift, interactive, explodeOnClick, width, height, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShardBurst'] > JSXAttribute[name.name='palette'] > Literal[value!=/^(?:ember|paper|crimson|orange|ink)$/]",
        "message": "<ShardBurst> palette must be one of 'ember' | 'paper' | 'crimson' | 'orange' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|dark|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onClick|onRemove|dark|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, selected, onClick, onRemove, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThumbNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|src|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ThumbNavItem> doesn't accept that prop. Declared props: label, src, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|onClose|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, title, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|side|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, children, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> side must be one of 'top' | 'bottom'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
